					<p class="help-block"><?= _t('ext.daily_digest.output.internal_base_help') ?></p>
				</div>
			</div>

			<div class="form-group">
				<div class="group-controls">
					<label class="checkbox" for="dd_mark_read">
						<input type="checkbox" id="dd_mark_read" name="mark_read" value="1" <?= !empty($cfg['mark_read']) ? 'checked="checked"' : '' ?> />
						<?= _t('ext.daily_digest.output.mark_read') ?>
					</label>
				</div>
			</div>
		</fieldset>

		<fieldset>
			<legend><?= _t('ext.daily_digest.schedule.title') ?></legend>

			<div class="form-group">
				<label class="group-name" for="dd_times"><?= _t('ext.daily_digest.schedule.times') ?></label>
				<div class="group-controls">
					<input type="text" id="dd_times" name="times" value="<?= $e($times) ?>" placeholder="<?= $e(DailyDigestExtension::DEFAULT_TIMES) ?>" />
					<p class="help-block"><?= _t('ext.daily_digest.schedule.times_help', $e(date_default_timezone_get())) ?></p>
				</div>
			</div>

			<div class="form-group">
				<label class="group-name"><?= _t('ext.daily_digest.schedule.mode') ?></label>
				<div class="group-controls">
					<label class="radio" for="dd_mode_combined">
						<input type="radio" id="dd_mode_combined" name="mode" value="<?= DailyDigestExtension::MODE_COMBINED ?>" <?= !$perCat ? 'checked="checked"' : '' ?> />
						<?= _t('ext.daily_digest.schedule.mode_combined') ?>
					</label>
					<label class="radio" for="dd_mode_per_category">
						<input type="radio" id="dd_mode_per_category" name="mode" value="<?= DailyDigestExtension::MODE_PER_CATEGORY ?>" <?= $perCat ? 'checked="checked"' : '' ?> />
						<?= _t('ext.daily_digest.schedule.mode_per_category') ?>
					</label>
					<p class="help-block"><?= _t('ext.daily_digest.schedule.mode_help') ?></p>
				</div>
			</div>

			<div class="form-group">
				<label class="group-name"><?= _t('ext.daily_digest.schedule.categories') ?></label>
				<div class="group-controls">
					<?php foreach ($selectable as $cat): ?>
						<?php
						$catPrompt = $this->categoryPrompt($cfg, $cat['id']);
						$catExcerpt = $this->categoryExcerptLength($cfg, $cat['id']);
						$hasSettings = $catPrompt !== '' || $catExcerpt !== null;
						?>
						<div class="dd-cat">
							<label class="checkbox" for="dd_cat_<?= $e((string)$cat['id']) ?>">
								<input type="checkbox" id="dd_cat_<?= $e((string)$cat['id']) ?>" name="categories[]" value="<?= $e((string)$cat['id']) ?>"
									<?= in_array($cat['id'], $selectedCats, true) ? 'checked="checked"' : '' ?> />
								<?= $e($cat['name']) ?>
							</label>
							<details class="dd-cat-prompt">
								<summary>⚙ <?= $e(_t('ext.daily_digest.schedule.category_settings')) ?><?= $hasSettings ? $e(_t('ext.daily_digest.schedule.category_settings_set')) : '' ?></summary>
								<textarea name="cat_prompt[<?= $e((string)$cat['id']) ?>]" rows="6" class="long"
									placeholder="<?= $e(_t('ext.daily_digest.schedule.category_prompt_placeholder')) ?>"><?= $e($catPrompt) ?></textarea>
								<label class="dd-cat-excerpt"><?= $e(_t('ext.daily_digest.schedule.category_excerpt_length')) ?>
									<input type="number" name="cat_excerpt[<?= $e((string)$cat['id']) ?>]" min="0" max="5000"
										value="<?= $e($catExcerpt === null ? '' : (string)$catExcerpt) ?>"
										placeholder="<?= $e(_t('ext.daily_digest.schedule.category_excerpt_placeholder', (int)$val('excerpt_length', DailyDigestExtension::DEFAULT_EXCERPT_LENGTH))) ?>" />
								</label>
							</details>
						</div>
					<?php endforeach; ?>
					<p class="help-block"><?= _t('ext.daily_digest.schedule.categories_help') ?></p>
					<p class="help-block"><?= $e(_t('ext.daily_digest.schedule.category_settings_help')) ?></p>
				</div>
			</div>

			<div class="form-group">
				<label class="group-name" for="dd_max_articles"><?= _t('ext.daily_digest.schedule.max_articles') ?></label>
				<div class="group-controls">
					<input type="number" id="dd_max_articles" name="max_articles" min="5" max="1000"
						value="<?= $e($val('max_articles', DailyDigestExtension::DEFAULT_MAX_ARTICLES)) ?>" />
					<p class="help-block"><?= _t('ext.daily_digest.schedule.max_articles_help') ?></p>
				</div>
