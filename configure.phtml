			<div class="form-group">
				<label class="group-name" for="dd_excerpt_length"><?= _t('ext.daily_digest.schedule.excerpt_length') ?></label>
				<div class="group-controls">
					<input type="number" id="dd_excerpt_length" name="excerpt_length" min="0" max="5000"
						value="<?= $e($val('excerpt_length', DailyDigestExtension::DEFAULT_EXCERPT_LENGTH)) ?>" />
					<p class="help-block"><?= _t('ext.daily_digest.schedule.excerpt_length_help') ?></p>
