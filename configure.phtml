		<div class="form-group form-actions">
			<div class="group-controls">
				<button type="submit" class="btn btn-important" name="dd_action" value="save"><?= _t('ext.daily_digest.actions.save') ?></button>
				<button type="submit" class="btn btn-attention" name="dd_action" value="test"><?= _t('ext.daily_digest.actions.test') ?></button>
				<button type="submit" class="btn" name="dd_action" value="generate"><?= _t('ext.daily_digest.actions.generate') ?></button>
				<p class="help-block"><?= _t('ext.daily_digest.actions.help') ?></p>
			</div>
		</div>
	</form>
</div>
